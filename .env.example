HOST_UID=1000
HOST_GID=1001

OPENAI_API_KEY=sk-XX
ANTHROPIC_API_KEY=sk-XX

VALID_ADCP_AUTH_KEYS=1,2,3

BASIC_AUTH_USER=XX
BASIC_AUTH_PASS=XX

MCP_SERVER_CHOICES=
#MCP_SERVER_CHOICES=[{"url": "https://yourlocal_server_or_ngrok_url", "label": "Local"}, {"url": "https://dev-demo-mcp.gotom.io", "label": "Dev Demo"}]

# RFC 9421 request signing towards the seller (optional — signing stays off
# when unset). Generate a keypair with `node scripts/gen-buyer-key.mjs`:
# it writes the private JWK to app/secrets/buyer-private.jwk (gitignored)
# and prints the public JWK to register with the seller.
# Relative paths resolve against the app/ directory.
ADCP_BUYER_PRIVATE_JWK_FILE=secrets/buyer-private.jwk
ADCP_BUYER_KID=
# Alternative to the file: the private JWK inline (JSON, single line, incl. "d")
#ADCP_BUYER_PRIVATE_JWK=
#ADCP_BUYER_AGENT_URL=https://your-buyer-agent.example
# REQUIRED for signature-only sessions (empty API key field): the password a
# browser user must enter in the sidebar. The signing key authenticates this
# SERVER, not the visitor — without this gate anyone reaching the UI could
# sign as the buyer. Unset => signature-only sessions are refused entirely.
ADCP_SIGNING_PASSWORD=
