{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".opencode/guidelines.md"
  ],
  "provider": {
    "ngrok-lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (Mike)",
      "options": {
        "baseURL": "https://homy-case-trophoplasmatic.ngrok-free.dev/v1",
        "headers": {
          "Authorization": "Basic {env:LMSTUDIO_BASIC_AUTH}"
        }
      },
      "models": {
        "qwen/qwen3.6-35b-a3b": {
          "name": "Qwen3 3.6 35b a3b (Local goTom LLM)",
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "options": {
            "temperature": 0.6,
            "top_p": 0.95,
            "top_k": 20,
            "min_p": 0.0,
            "presence_penalty": 0.0,
            "repetition_penalty": 1.0
          }
        }
      }
    }
  },
  "model": "qwen/qwen3.6-35b-a3b"
}
